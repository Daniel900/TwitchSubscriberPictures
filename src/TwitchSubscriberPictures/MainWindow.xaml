<Window x:Class="TwitchSubscriberPictures.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Twitch Subscriber Pictures"
        Height="760"
        Width="1000"
        MinHeight="600"
        MinWidth="800"
        Closing="OnClosing"
        Loaded="OnLoaded">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="2*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <Ellipse Width="14"
                     Height="14"
                     VerticalAlignment="Center"
                     Margin="0,0,8,0"
                     Fill="{Binding ConnectionStatusBrush}" />
            <TextBlock VerticalAlignment="Center"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Text="{Binding ConnectionStatusText}" />
            <Button DockPanel.Dock="Right"
                    Width="110"
                    Content="Update now"
                    Command="{Binding UpdateNowCommand}" />
        </DockPanel>

        <GroupBox Grid.Row="1" Header="Photo folders" Margin="0,0,0,12">
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           Text="AllPhotos" />
                <TextBox Grid.Row="0"
                         Grid.Column="1"
                         Margin="8,4"
                         Text="{Binding AllPhotosPath, UpdateSourceTrigger=PropertyChanged}" />
                <Button Grid.Row="0"
                        Grid.Column="2"
                        Margin="4"
                        Width="80"
                        Content="Browse..."
                        Command="{Binding BrowseAllPhotosCommand}" />

                <TextBlock Grid.Row="1"
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           Text="ActivePhotos" />
                <TextBox Grid.Row="1"
                         Grid.Column="1"
                         Margin="8,4"
                         Text="{Binding ActivePhotosPath, UpdateSourceTrigger=PropertyChanged}" />
                <Button Grid.Row="1"
                        Grid.Column="2"
                        Margin="4"
                        Width="80"
                        Content="Browse..."
                        Command="{Binding BrowseActivePhotosCommand}" />
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="2" Header="Twitch connection" Margin="0,0,0,12">
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           Text="Client ID" />
                <TextBox Grid.Row="0"
                         Grid.Column="1"
                         Grid.ColumnSpan="4"
                         Margin="8,4"
                         Text="{Binding TwitchClientId, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Grid.Row="1"
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           Text="Poll interval (min)" />
                <TextBox Grid.Row="1"
                         Grid.Column="1"
                         Margin="8,4"
                         Text="{Binding PollIntervalMinutes, UpdateSourceTrigger=PropertyChanged}" />
                <Button Grid.Row="1"
                        Grid.Column="2"
                        Margin="4"
                        Width="110"
                        Content="Connect Twitch"
                        Command="{Binding ConnectTwitchCommand}" />
                <Button Grid.Row="1"
                        Grid.Column="3"
                        Margin="4"
                        Width="100"
                        Content="Save settings"
                        Command="{Binding SaveSettingsCommand}" />
                <TextBlock Grid.Row="1"
                           Grid.Column="4"
                           VerticalAlignment="Center"
                           Margin="8,0,0,0"
                           Foreground="Gray"
                           Text="Minimum 10" />
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="3" Header="Active subscribers" Margin="0,0,0,12">
            <DataGrid Margin="8"
                      ItemsSource="{Binding Subscribers}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Login"
                                        Width="*"
                                        Binding="{Binding Login}" />
                    <DataGridTextColumn Header="Display name"
                                        Width="*"
                                        Binding="{Binding DisplayName}" />
                    <DataGridCheckBoxColumn Header="Missing photo"
                                            Width="Auto"
                                            Binding="{Binding IsMissingPhoto}" />
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <GroupBox Grid.Row="4" Header="Activity / error log">
            <ListBox Margin="8"
                     ItemsSource="{Binding LogEntries}"
                     VirtualizingPanel.IsVirtualizing="True"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding DisplayText}"
                                   TextWrapping="Wrap"
                                   FontFamily="Consolas"
                                   FontSize="12" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </GroupBox>
    </Grid>
</Window>
