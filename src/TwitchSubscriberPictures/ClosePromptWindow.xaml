<Window x:Class="TwitchSubscriberPictures.ClosePromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Close Twitch Subscriber Pictures"
        Height="190"
        Width="420"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="What would you like to do?"
                   FontSize="16"
                   FontWeight="SemiBold" />

        <TextBlock Grid.Row="1"
                   Margin="0,12,0,0"
                   TextWrapping="Wrap"
                   Text="Minimize to tray keeps the app running and EventSub connected. Close application exits immediately." />

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">
            <Button Width="110"
                    Margin="0,0,8,0"
                    Content="Minimize to tray"
                    Click="OnMinimizeToTray" />
            <Button Width="90"
                    Margin="0,0,8,0"
                    Content="Close"
                    Click="OnClose" />
            <Button Width="80"
                    Content="Cancel"
                    IsCancel="True"
                    Click="OnCancel" />
        </StackPanel>
    </Grid>
</Window>
